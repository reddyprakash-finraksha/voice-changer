# --- App ---
ENV=development
DEBUG=true

# --- Security (required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme_generate_a_real_secret

# --- ElevenLabs (voice cloning + TTS) ---
ELEVENLABS_API_KEY=

# --- Translation ---
TRANSLATION_PROVIDER=google_free
DEEPL_API_KEY=

# --- Supabase (optional; local disk storage is used if unset) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:8501"]
